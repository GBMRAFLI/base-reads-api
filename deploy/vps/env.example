# Copy to /etc/base-reads/env (owner root, mode 600). Names only; never commit values.
PORT=8000
# HOST defaults to 127.0.0.1 when TRUST_PROXY=1
HOST=127.0.0.1
TRUST_PROXY=1
KV_PATH=/var/lib/base-reads/kv.sqlite3
# Append-only payment ledger (spent authorizations + settlement tx hashes); never restored or rolled back
LEDGER_PATH=/var/lib/base-reads/ledger.sqlite3
# On-chain finality: confirmations required before a paid response is served (1 = receipt is enough; raise to wait longer)
MIN_CONFIRMATIONS=1
# Public origin used in 402 resource URLs, llms.txt, openapi.json. Must match the Caddyfile site address.
PUBLIC_URL=https://API_DOMAIN_PLACEHOLDER
# Hostname only; setup.sh and deploy.sh render the Caddyfile from it
API_DOMAIN=API_DOMAIN_PLACEHOLDER
NETWORK=
PAY_TO_ADDRESS=
FACILITATOR=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
RPC=
ONCHAIN_CHECK=
SELF_WALLETS=
# Verification/monitoring bots, excluded from organic buyers (payerClass=monitor):
#   MONITOR_WALLETS = comma list of their payer wallets
#   MONITOR_UA      = comma list of User-Agent substrings (unset or empty = built-in defaults)
MONITOR_WALLETS=
SIGNING_KEY_ENC_B64=
SIGNING_KEY_PASSPHRASE=
SIGNING_KEY_CREATED_AT=
SIGNING_KEY_HISTORY=
EXPORT_TOKEN=
INDEX_VERIFY_TOKEN=
REPO_URL=
SNAPSHOT_SCHEDULER=1
# Bazaar pages per daily snapshot (1000 listings each); default 50, hard cap 100; 10 min time budget. Complete only on a short final page.
SNAPSHOT_MAX_PAGES=50
# Trial keys (optional). Hashed keys file managed with deno/scripts/trial_key.ts; missing or empty file = no trial access.
# Must be inside a path the service may read (--allow-read); the default sits in the state directory.
TRIAL_KEYS_FILE=/var/lib/base-reads/trial-keys.json
# Served trial calls per key per UTC day; default 50, clamped to 1..10000.
TRIAL_DAILY_LIMIT=50
