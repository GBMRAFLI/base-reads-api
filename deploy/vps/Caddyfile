	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output file /var/log/caddy/base-reads.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
