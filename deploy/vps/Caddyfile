# setup.sh replaces API_DOMAIN_PLACEHOLDER with $API_DOMAIN. After editing by hand: systemctl restart caddy
# (the admin API is off, so `caddy reload` / `systemctl reload caddy` are not used).
{
	admin off
}

API_DOMAIN_PLACEHOLDER {
	encode gzip
	# /healthz is for local deploy checks only (the app also rejects non-loopback peers)
	respond /healthz 404
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output file /var/log/caddy/base-reads.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
